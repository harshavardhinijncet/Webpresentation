# Copy to .env, or set these in the deployment platform's environment panel —
# the panel is better, because then they are never written to disk.
# .env and .env.* are gitignored; .env.example is not. Never put a real secret here.

# --- server -----------------------------------------------------------------
PORT=4173
# 0.0.0.0 inside a container, so the platform can reach it. 127.0.0.1 locally.
HOST=127.0.0.1

# --- sessions ---------------------------------------------------------------
# Signs the session cookie. WITHOUT THIS a random secret is generated at boot,
# so every restart signs every user out. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 1 behind HTTPS. Leave off for plain-http local work or the cookie is dropped.
COOKIE_SECURE=0

# --- media ------------------------------------------------------------------
# CloudFront (or S3 website) prefix for images and films. Leave EMPTY to serve
# from backend/uploads, which is what local development and the offline
# presentation path both rely on. No AWS credentials belong in this file: the
# bucket is read through CloudFront, and uploads are an operations task.
MEDIA_BASE_URL=

# --- seeded accounts --------------------------------------------------------
# CHANGE THESE. The defaults are published in this repository's README and in
# every commit of it; on a public URL they are not a login, they are an invitation.
ADMIN_EMAIL=admin@org.local
ADMIN_PASSWORD=
PRESENTER_EMAIL=presenter@org.local
PRESENTER_PASSWORD=
